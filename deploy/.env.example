TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Comma-separated negative group chat IDs; empty disables groups.
TELEGRAM_ALLOWED_GROUPS=
# Enable only after authorizing group context delivery to the configured model API.
DAFEIYU_GROUP_CONTEXT_ENABLED=0
# Metadata-only receive/cache/request diagnostics; no message bodies logged.
DAFEIYU_GROUP_CONTEXT_DEBUG=0
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
BREEZE_API_KEY=
DAFEIYU_RARE_VOICE=0
# JSON presentation for the Dafeiyu persona; 0 restores legacy marker/regex handling.
DAFEIYU_STRUCTURED_REPLY=1
