[Unit]
Description=Dafeiyu AstrBot Telegram Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/service/dafeiyu
ExecStart=/root/service/dafeiyu/.venv/bin/python /root/service/dafeiyu/deploy/run-native.py
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
